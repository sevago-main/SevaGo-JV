# Copy these into Vercel -> Project -> Settings -> Environment Variables (never commit real values)

# AWS RDS / Aurora PostgreSQL connection string
DATABASE_URL=postgres://sevago_web:CHANGE_ME@your-db.xxxx.ap-south-1.rds.amazonaws.com:5432/sevago
# PEM text of the RDS CA bundle (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
# Required so the TLS connection is verified. For a quick test only you may set DATABASE_SSL_NO_VERIFY=true instead.
DATABASE_CA=
DATABASE_SSL_NO_VERIFY=

# Random 32+ char secrets (e.g. `openssl rand -hex 32`)
IP_HASH_SALT=
ADMIN_EXPORT_TOKEN=

# Comma separated origins allowed to call the API
ALLOWED_ORIGINS=https://sevago.co.in,https://www.sevago.co.in
